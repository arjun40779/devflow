{
    "name": "@devflow/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@devflow/config": "workspace:*",
        "@fastify/cors": "^10.0.1",
        "@fastify/helmet": "^12.0.1",
        "@fastify/rate-limit": "^10.1.1",
        "@fastify/sensible": "^6.0.2",
        "@fastify/swagger": "^9.2.0",
        "@scalar/fastify-api-reference": "^1.25.101",
        "dotenv": "^16.4.5",
        "fastify": "^5.1.0",
        "fastify-plugin": "^5.0.1",
        "fastify-type-provider-zod": "^4.0.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "pino-pretty": "^13.0.0",
        "rimraf": "^6.0.1",
        "tsup": "^8.3.5",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vitest": "^2.1.5"
    }
